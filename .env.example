# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/generate-text).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Optional base path override for Vite production builds.
# Defaults to "./" so the built dist/ folder works on both GitHub Pages subpaths
# (https://username.github.io/repository-name/) and root domains (/).
VITE_BASE_PATH="./"

# VITE_API_BASE_URL: Optional backend API URL if frontend is hosted separately from server.ts.
# Leave empty for same-origin server or static GitHub Pages mode.
VITE_API_BASE_URL=""

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Optional credentials for Google OAuth sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
